#!/usr/bin/env python3
"""
wayland-zeroprint: Zero-Drop Hardware PrintScreen Daemon for Linux Wayland.

Intercepts physical PrintScreen interrupts from Linux evdev input nodes,
bypassing Wayland compositor grab locks and popup dismissal, capturing
lossless frames directly to shared memory (/dev/shm) and streaming them
to the Wayland clipboard via wl-copy without onlyReplaceEmpty lockouts.
"""

import glob
import os
import select
import shutil
import signal
import struct
import subprocess
import sys
import time

# Linux input event constants (linux/input-event-codes.h)
EV_KEY = 1
KEY_SYSRQ = 99
KEY_PRINT = 210

# 64-bit Linux struct input_event layout:
EVENT_FORMAT = "@qqHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

# Shared memory RAM buffer (tmpfs) to eliminate disk I/O latency
SHM_BUFFER = "/dev/shm/wayland_zeroprint.png"


def detect_capture_command():
    """Determine the optimal screenshot backend based on active desktop and available tools."""
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()

    if "kde" in desktop and shutil.which("spectacle"):
        return ["spectacle", "-b", "-f", "-n", "-o", SHM_BUFFER]

    if "gnome" in desktop:
        if shutil.which("gdbus"):
            return [
                "gdbus", "call", "--session",
                "--dest", "org.gnome.Shell.Screenshot",
                "--object-path", "/org/gnome/Shell/Screenshot",
                "--method", "org.gnome.Shell.Screenshot.Screenshot",
                "true", "false", SHM_BUFFER
            ]
        if shutil.which("gnome-screenshot"):
            return ["gnome-screenshot", "-f", SHM_BUFFER]

    if shutil.which("grim"):
        return ["grim", SHM_BUFFER]

    if shutil.which("spectacle"):
        return ["spectacle", "-b", "-f", "-n", "-o", SHM_BUFFER]

    return None


def get_input_fds():
    """Discover and open all available evdev input nodes in non-blocking mode."""
    fds = {}
    for dev_path in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(dev_path, os.O_RDONLY | os.O_NONBLOCK)
            fds[fd] = dev_path
        except (PermissionError, OSError):
            pass
    return fds


def capture_screenshot(cmd):
    """Capture full screen to shared memory RAM and pipe asynchronously into clipboard."""
    if not cmd:
        return

    env = os.environ.copy()
    if "WAYLAND_DISPLAY" not in env:
        env["WAYLAND_DISPLAY"] = "wayland-0"
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    env["DISPLAY"] = env.get("DISPLAY", ":0")

    if os.path.exists(SHM_BUFFER):
        try:
            os.remove(SHM_BUFFER)
        except OSError:
            pass

    # Execute backend capture quietly into RAM buffer
    subprocess.run(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=env
    )

    # Forceful byte stream injection into Wayland clipboard, avoiding onlyReplaceEmpty lockouts
    if os.path.exists(SHM_BUFFER) and os.path.getsize(SHM_BUFFER) > 100:
        try:
            with open(SHM_BUFFER, "rb") as fp:
                subprocess.Popen(
                    ["wl-copy", "-t", "image/png"],
                    stdin=fp,
                    env=env,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
        except Exception:
            pass


def main():
    def handle_exit(signum, frame):
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_exit)
    signal.signal(signal.SIGTERM, handle_exit)

    capture_cmd = detect_capture_command()
    if not capture_cmd:
        sys.stderr.write("wayland-zeroprint: No supported screenshot backend found (spectacle, grim, or gnome-screenshot).\n")
        sys.exit(1)

    if not shutil.which("wl-copy"):
        sys.stderr.write("wayland-zeroprint: 'wl-copy' (wl-clipboard) not found in PATH.\n")
        sys.exit(1)

    fds = get_input_fds()
    if not fds:
        sys.stderr.write("wayland-zeroprint: No readable /dev/input/event* nodes found. Check udev permissions or group membership.\n")
        sys.exit(1)

    poll_obj = select.poll()
    for fd in fds:
        poll_obj.register(fd, select.POLLIN)

    last_trigger = 0.0

    while True:
        try:
            events = poll_obj.poll(1000)

            # Refresh descriptors on timeout to handle hotplugged keyboards
            if not events:
                new_fds = get_input_fds()
                if set(new_fds.keys()) != set(fds.keys()):
                    for fd in list(fds.keys()):
                        try:
                            poll_obj.unregister(fd)
                            os.close(fd)
                        except Exception:
                            pass
                    fds = new_fds
                    for fd in fds:
                        poll_obj.register(fd, select.POLLIN)
                continue

            for fd, event in events:
                if event & select.POLLIN:
                    try:
                        chunk = os.read(fd, EVENT_SIZE * 16)
                        if not chunk:
                            continue

                        for offset in range(0, len(chunk) - EVENT_SIZE + 1, EVENT_SIZE):
                            sec, usec, ev_type, code, value = struct.unpack(
                                EVENT_FORMAT, chunk[offset:offset + EVENT_SIZE]
                            )

                            # Trigger on key down (value == 1) for PrintScreen / SysRq
                            if ev_type == EV_KEY and code in (KEY_SYSRQ, KEY_PRINT) and value == 1:
                                now = time.time()
                                if now - last_trigger > 0.35:
                                    last_trigger = now
                                    capture_screenshot(capture_cmd)
                    except (BlockingIOError, OSError):
                        pass
        except Exception:
            time.sleep(0.5)


if __name__ == "__main__":
    main()
