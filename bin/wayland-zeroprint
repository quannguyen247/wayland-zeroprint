#!/usr/bin/env python3
"""
wayland-zeroprint: Zero-Drop Hardware PrintScreen Daemon for Linux Wayland.
Captures lossless pixel-by-pixel screenshots directly into the Wayland clipboard
by reading hardware interrupts via the Linux evdev subsystem, bypassing compositor grab locks.
"""

import glob
import os
import select
import struct
import subprocess
import time
import signal
import sys

# Linux Input Event Constants
EV_KEY = 1
KEY_SYSRQ = 99
KEY_PRINT = 210

# 64-bit Linux struct input_event layout:
# tv_sec (8B), tv_usec (8B), type (2B), code (2B), value (4B) = 24 Bytes
EVENT_FORMAT = "@qqHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

# In-memory RAM buffer (tmpfs) for zero disk I/O
SHM_BUFFER = "/dev/shm/wayland_zeroprint.png"

def get_input_fds():
    """Discover and open all available evdev input nodes in non-blocking mode."""
    fds = {}
    for dev in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            fds[fd] = dev
        except (PermissionError, OSError):
            pass
    return fds

def capture_screenshot():
    """Trigger background capture and stream directly to Wayland clipboard."""
    env = os.environ.copy()
    if "WAYLAND_DISPLAY" not in env:
        env["WAYLAND_DISPLAY"] = "wayland-0"
    if "XDG_RUNTIME_DIR" not in env:
        env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    env["DISPLAY"] = env.get("DISPLAY", ":0")
    env["QT_LOGGING_RULES"] = "*=false"

    if os.path.exists(SHM_BUFFER):
        try:
            os.remove(SHM_BUFFER)
        except OSError:
            pass

    # 1. Native compositor screen grab directly into shared memory RAM
    subprocess.run(
        ["/usr/bin/spectacle", "-b", "-f", "-n", "-o", SHM_BUFFER],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=env
    )

    # 2. Asynchronous pipe injection into Wayland clipboard
    if os.path.exists(SHM_BUFFER) and os.path.getsize(SHM_BUFFER) > 100:
        try:
            with open(SHM_BUFFER, "rb") as f:
                subprocess.Popen(
                    ["wl-copy", "-t", "image/png"],
                    stdin=f,
                    env=env,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
        except Exception:
            pass

def signal_handler(signum, frame):
    sys.exit(0)

def main():
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)

    fds = get_input_fds()
    if not fds:
        sys.stderr.write("wayland-zeroprint: No readable /dev/input/event* devices found. Check udev permissions.\n")
        sys.exit(1)

    poll_obj = select.poll()
    for fd in fds:
        poll_obj.register(fd, select.POLLIN)

    last_trigger = 0.0

    while True:
        try:
            events = poll_obj.poll(1000)
            if not events:
                # Refresh file descriptors for hotplugged input devices
                new_fds = get_input_fds()
                if set(new_fds.keys()) != set(fds.keys()):
                    for fd in list(fds.keys()):
                        try:
                            poll_obj.unregister(fd)
                            os.close(fd)
                        except Exception:
                            pass
                    fds = new_fds
                    for fd in fds:
                        poll_obj.register(fd, select.POLLIN)
                continue

            for fd, event in events:
                if event & select.POLLIN:
                    try:
                        data = os.read(fd, EVENT_SIZE * 16)
                        if not data:
                            continue

                        for i in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                            sec, usec, ev_type, code, value = struct.unpack(EVENT_FORMAT, data[i:i + EVENT_SIZE])

                            # Detect hardware key press (value == 1: KEY_DOWN)
                            if ev_type == EV_KEY and code in (KEY_SYSRQ, KEY_PRINT) and value == 1:
                                now = time.time()
                                if now - last_trigger > 0.35:
                                    last_trigger = now
                                    capture_screenshot()
                    except (BlockingIOError, OSError):
                        pass
        except Exception:
            time.sleep(0.5)

if __name__ == "__main__":
    main()
