[Unit]
Description=Zero-Drop Hardware PrintScreen Daemon for Linux Wayland
Documentation=https://github.com/quannguyen247/wayland-zeroprint
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wayland-zeroprint
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
